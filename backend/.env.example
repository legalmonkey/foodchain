# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB Atlas URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/foodchain?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Blockchain / Web3 Configuration (Polygon Amoy)
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your-api-key
BACKEND_WALLET_PRIVATE_KEY=your_backend_relayer_private_key_here

# IPFS Pinata Configuration
PINATA_JWT=your_pinata_jwt_token_here
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# Deployed Smart Contract Addresses
USER_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
ORDER_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
COMPLAINT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
DISPUTE_RESOLUTION_ADDRESS=0x0000000000000000000000000000000000000000
REPUTATION_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000

# Order Lifecycle Timers (in seconds, configurable for testing/demo)
TIMER_PLACED_TO_ACCEPTED=20
TIMER_ACCEPTED_TO_PREPARING=45
TIMER_PREPARING_TO_OUT=60
TIMER_OUT_TO_DELIVERED=90
